# Copy to .env and edit:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

# --- PostgreSQL (one instance, two databases: "leads" for app data, "n8n" for n8n itself)
POSTGRES_USER=leads_app
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=leads
# Host port only (containers use 5432). 5442 avoids clashing with a local Postgres on 5432/5433.
POSTGRES_PORT=5442

# --- n8n
# Host port for the n8n UI and webhooks (http://localhost:<port>). 5679 avoids the n8n default 5678.
N8N_HOST_PORT=5679
# Encrypts credentials stored in n8n. Generate your own: openssl rand -hex 24
# Changing it later makes previously stored credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-demo-encryption-key-0123456789

# Shared secret callers must send in the X-Webhook-Secret header.
LEAD_WEBHOOK_SECRET=change-me-webhook-secret

# --- Claude (Messages API, called from n8n's HTTP Request node)
# Only the one-shot n8n-init container reads this; it is stored encrypted as an n8n credential.
# Leave empty to boot the stack; qualification then fails safe into `needs_review`.
ANTHROPIC_API_KEY=
# Point at the mock server for keyless runs (see mock/). Real API: https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Model ID is configuration, never hard-coded in a workflow. Check
# https://platform.claude.com/docs/en/about-claude/models/overview before changing.
CLAUDE_MODEL=claude-haiku-5-5
# Which prompts/qualify.<version>.md to load.
QUALIFY_PROMPT_VERSION=v1

# --- Business settings
OWNER_EMAIL=owner@acme.test
MAIL_FROM="Acme Sales <sales@acme.test>"
# Placeholder booking link. Replace with a real scheduler URL (Calendly, Cal.com, ...).
BOOKING_LINK_URL=https://example.com/book-a-call
