[
  {
    "id": "cred-postgres",
    "name": "Leads Postgres",
    "type": "postgres",
    "data": {
      "host": "postgres",
      "port": 5432,
      "database": "${POSTGRES_DB}",
      "user": "${POSTGRES_USER}",
      "password": "${POSTGRES_PASSWORD}",
      "maxConnections": 10,
      "allowUnauthorizedCerts": false,
      "ssl": "disable"
    }
  },
  {
    "id": "cred-smtp",
    "name": "Mailpit SMTP",
    "type": "smtp",
    "data": {
      "host": "mailpit",
      "port": 1025,
      "secure": false,
      "disableStartTls": true,
      "user": "",
      "password": ""
    }
  },
  {
    "id": "cred-anthropic",
    "name": "Anthropic API key",
    "type": "httpHeaderAuth",
    "data": {
      "name": "x-api-key",
      "value": "${ANTHROPIC_API_KEY}"
    }
  },
  {
    "id": "cred-webhook-secret",
    "name": "Lead webhook shared secret",
    "type": "httpHeaderAuth",
    "data": {
      "name": "X-Webhook-Secret",
      "value": "${LEAD_WEBHOOK_SECRET}"
    }
  }
]
